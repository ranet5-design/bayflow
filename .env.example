# --- App ---
# development | production (production refuses to start without JWT_SECRET)
NODE_ENV=development
# Port the server listens on. Hosting platforms usually set this for you.
PORT=4000
# Only needed if the frontend is served from a different origin (enables CORS for it).
# Leave empty when using the built-in frontend.
CLIENT_URL=
# Timezone used for "today" and slot times. Should match where the shops are.
TZ=Asia/Karachi

# --- Database ---
# SQLite file path. The folder is created automatically.
DATABASE_PATH=./data/bayflow.db
# true = load demo data on startup when the database is empty (useful on free hosts
# whose disk is wiped on redeploy). npm run seed always resets the data.
SEED_ON_START=true

# --- Auth ---
# Long random string used to sign login tokens. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
# How long a login stays valid (e.g. 12h, 7d)
JWT_EXPIRES_IN=7d

# --- Email (optional, not used yet; in-app notifications are used instead) ---
SMTP_HOST=
SMTP_USER=
SMTP_PASS=

# --- Bonus: calling / AI (leave blank, not implemented) ---
CALL_PROVIDER_API_KEY=
LLM_API_KEY=
STT_TTS_API_KEY=
